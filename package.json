{
  "name": "jiahao-institute",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test test/unit/*.test.mjs test/core.test.mjs test/observability.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs test/core.test.mjs test/observability.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:all": "node --test test/unit/*.test.mjs test/core.test.mjs test/observability.test.mjs && node --test test/integration/*.test.mjs",
    "test:coverage": "node test/helpers/ai-test-analyzer.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^17.4.2",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.8.69",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
